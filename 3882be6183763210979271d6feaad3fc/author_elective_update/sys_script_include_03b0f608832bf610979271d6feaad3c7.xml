        <script><![CDATA[var StudentLogin = Class.create();
StudentLogin.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    validateLogin: function() {

        var username = this.getParameter('sysparm_username');
        var password = this.getParameter('sysparm_password');

        var gr = new GlideRecord('x_1909965_almaconn_student');
        gr.addQuery('u_student_user', username);
        gr.addQuery('u_password', password);
        gr.query();

        if (gr.next()) {
            return "true";
        } else {
            return "false";
        }
    }

});]]></script>
