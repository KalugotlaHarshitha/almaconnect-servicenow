        <api_name>x_1909965_almaconn.CheckstudentLogin</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Student Login</description>
        <mobile_callable>true</mobile_callable>
        <name>CheckstudentLogin</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckCheckstudentLogin = Class.create();
CheckCheckstudentLogin.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    checkLogin: function() {

        var number = this.getParameter('sysparm_number');
        var password = this.getParameter('sysparm_password');

        // Check if fields are empty
        if (!number || !password) {
            return 'empty';
        }

        var gr = new GlideRecord('student');
        gr.addQuery('number', number);
        gr.addQuery('password', password);
        gr.query();

        if (gr.next()) {
            return 'true';
        } else {
            return 'false';
        }
    }

});]]></script>
