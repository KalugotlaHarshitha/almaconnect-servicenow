        <script><![CDATA[function transform(input) {
    var isValid = false;
    
    // 1. Get the typed username and password from UI Builder
    var user = input.username;
    var pass = input.password;
    
    // 2. Query your specific Student table
    var gr = new GlideRecord('x_1909965_almaconn_student'); 
    
    // 3. Check if the number (username) and password match
    gr.addQuery('number', user); 
    
    // Note: If 'password' is a custom field you created, it might actually be 
    // named something like 'x_1909965_almaconn_password'. If the login always 
    // fails during testing, check Studio again to see if it has that prefix!
    gr.addQuery('password', pass); 
    gr.query();
    
    // 4. If a match is found in the student table, set to true
    if (gr.next()) {
        isValid = true;
    }
    
    // Return the true/false result back to UI Builder
    return {
        success: isValid
    };
}]]></script>
