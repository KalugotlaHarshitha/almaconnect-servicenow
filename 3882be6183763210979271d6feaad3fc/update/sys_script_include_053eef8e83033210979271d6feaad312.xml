        <script><![CDATA[var MentorshipUtils = Class.create();
MentorshipUtils.prototype = {

    getRequestsSentCount: function() {

        var ga = new GlideAggregate('x_almaconnect_mentorship_request');
        ga.addQuery('student', gs.getUserID());
        ga.addAggregate('COUNT');
        ga.query();

        var count = 0;

        if (ga.next()) {
            count = ga.getAggregate('COUNT');
        }

        return count;
    },

    type: 'MentorshipUtils'
};]]></script>
